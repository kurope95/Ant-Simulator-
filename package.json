{
  "name": "ant-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/tests/**/*.test.js\"",
    "serve": "node tools/serve.mjs",
    "bench": "npm run build && node dist/src/app/bench_cli.js",
    "reach": "npm run build && node dist/src/app/reach_cli.js",
    "screenshot": "npm run build && node tools/screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
